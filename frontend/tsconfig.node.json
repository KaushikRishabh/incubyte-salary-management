{
  "compilerOptions": {
    // Project references require composite metadata even though Vite performs emission.
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  // Keep tool configuration separate from the browser application source.
  "include": ["vite.config.ts"]
}
